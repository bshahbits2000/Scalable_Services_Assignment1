          "spec": {
            "containers": [
              {
                "name": "inventory",
                "image": "seatflow-a2-inventory:local",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "containerPort": 8082
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  }
                },
                "env": [
                  {
                    "name": "HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "PORT",
                    "value": "8082"
                  },
                  {
                    "name": "DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "seatflow-db",
                        "key": "inventory-url"
                      }
                    }
                  },
                  {
                    "name": "DB_POOL_SIZE",
                    "value": "8"
                  },
                  {
                    "name": "ENABLE_SIMULATION",
                    "value": "true"
                  },
                  {
                    "name": "WORKER_INTERVAL_MS",
                    "value": "1000"
                  },
                  {
                    "name": "HTTP_TIMEOUT_MS",
                    "value": "1000"
                  },
                  {
                    "name": "RETRY_ATTEMPTS",
                    "value": "3"
                  },
                  {
                    "name": "RETRY_BASE_MS",
                    "value": "80"
                  },
                  {
                    "name": "MOCK_DELAY_MS",
                    "value": "1200"
                  },
                  {
                    "name": "INVENTORY_URL",
                    "value": "http://inventory:8082"
                  },
                  {
                    "name": "PAYMENT_URL",
                    "value": "http://payment:8083"
                  },
                  {
                    "name": "NOTIFICATION_URL",
                    "value": "http://notification:8084"
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8082
                  },
                  "periodSeconds": 2,
                  "timeoutSeconds": 3,
                  "failureThreshold": 90
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8082
                  },
                  "periodSeconds": 3,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8082
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                }
              }
            ],
            "initContainers": [
              {
                "name": "wait-for-database",
                "image": "seatflow-a2-postgres:local",
                "imagePullPolicy": "Never",
                "command": [
                  "sh",
                  "-c",
                  "until pg_isready -h postgres -U postgres; do sleep 2; done"
                ]
              }
            ]
          }
        }
      }
    },
