{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "postgres-init",
        "namespace": "seatflow-a2-demo"
      },
      "data": {
        "00-seatflow.sh": "#!/bin/sh\nset -eu\npsql -v ON_ERROR_STOP=1 --username \"$POSTGRES_USER\" --dbname postgres \\\n  --set=bpass=\"$BOOKING_PASSWORD\" --set=ipass=\"$INVENTORY_PASSWORD\" \\\n  --set=ppass=\"$PAYMENT_PASSWORD\" --set=npass=\"$NOTIFICATION_PASSWORD\" <<'SQL'\nCREATE ROLE sf_booking LOGIN PASSWORD :'bpass';\nCREATE ROLE sf_inventory LOGIN PASSWORD :'ipass';\nCREATE ROLE sf_payment LOGIN PASSWORD :'ppass';\nCREATE ROLE sf_notification LOGIN PASSWORD :'npass';\nCREATE DATABASE sf_booking OWNER sf_booking;\nCREATE DATABASE sf_inventory OWNER sf_inventory;\nCREATE DATABASE sf_payment OWNER sf_payment;\nCREATE DATABASE sf_notification OWNER sf_notification;\nREVOKE ALL ON DATABASE sf_booking FROM PUBLIC;\nREVOKE ALL ON DATABASE sf_inventory FROM PUBLIC;\nREVOKE ALL ON DATABASE sf_payment FROM PUBLIC;\nREVOKE ALL ON DATABASE sf_notification FROM PUBLIC;\nGRANT CONNECT ON DATABASE sf_booking TO sf_booking;\nGRANT CONNECT ON DATABASE sf_inventory TO sf_inventory;\nGRANT CONNECT ON DATABASE sf_payment TO sf_payment;\nGRANT CONNECT ON DATABASE sf_notification TO sf_notification;\nSQL\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "postgres-data",
        "namespace": "seatflow-a2-demo"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "postgres",
        "namespace": "seatflow-a2-demo"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "postgres"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "postgres",
                "image": "seatflow-a2-postgres:local",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "env": [
                  {
                    "name": "POSTGRES_USER",
                    "value": "postgres"
                  },
                  {
                    "name": "POSTGRES_DB",
                    "value": "postgres"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "seatflow-db",
                        "key": "postgres-password"
                      }
                    }
                  },
                  {
                    "name": "BOOKING_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "seatflow-db",
                        "key": "booking-password"
                      }
                    }
                  },
                  {
                    "name": "INVENTORY_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "seatflow-db",
                        "key": "inventory-password"
                      }
                    }
                  },
                  {
                    "name": "PAYMENT_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "seatflow-db",
                        "key": "payment-password"
                      }
                    }
                  },
                  {
                    "name": "NOTIFICATION_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "seatflow-db",
                        "key": "notification-password"
                      }
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "database",
                    "mountPath": "/var/lib/postgresql/data"
                  },
                  {
                    "name": "initialization",
                    "mountPath": "/docker-entrypoint-initdb.d"
                  }
                ],
                "startupProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "postgres"
                    ]
                  },
                  "periodSeconds": 2,
                  "failureThreshold": 90
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "postgres"
                    ]
                  },
                  "periodSeconds": 3
                }
              }
            ],
            "volumes": [
              {
                "name": "database",
                "persistentVolumeClaim": {
                  "claimName": "postgres-data"
                }
              },
              {
                "name": "initialization",
                "configMap": {
                  "name": "postgres-init"
                }
              }
            ]
          }
        }
      }
    },
